# ─────────────────────────────────────────────────────────────────────────────
# Notion Local Sync — environment configuration template
#
# Copy this file to .env and fill in your own values.
# The app also lets you configure everything through the Settings dialog
# (right-click the tray icon → Settings), which saves values here automatically.
#
# SECURITY: Never commit .env or secret.key to source control.
# Both are excluded by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Notion ────────────────────────────────────────────────────────────────────
# Your Notion integration token.
# Create one at: https://www.notion.so/my-integrations
# It looks like: secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The app stores this encrypted — leave NOTION_TOKEN blank and let the Settings
# dialog fill in NOTION_TOKEN_ENCRYPTED automatically.
NOTION_TOKEN=
NOTION_TOKEN_ENCRYPTED=

# Which Notion databases to sync.
# Use ALL to sync every database you've shared with your integration,
# or enter specific database IDs separated by commas.
# To find a database ID: open the database in Notion, copy the URL —
# the 32-character hex string after the last / is the ID.
# Example: NOTION_DB_ID=3b1234abcd5678ef,9f0000112233aabb
NOTION_DB_ID=ALL

# Notion API version (do not change unless you know what you're doing)
NOTION_VERSION=2022-06-28
NOTION_API_BASE=https://api.notion.com/v1


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection details for your local PostgreSQL installation.
# The app creates the database automatically if it doesn't exist.
# Default install on Windows: host=localhost, port=5432, user=postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres

# Your PostgreSQL password.
# Leave PG_PASSWORD blank — the Settings dialog stores it encrypted in
# PG_PASSWORD_ENCRYPTED automatically.
PG_PASSWORD=
PG_PASSWORD_ENCRYPTED=

# Name of the database the app creates/uses (auto-created if it doesn't exist)
PG_DBNAME=notion_mirror

# Connection timeout in seconds
PG_CONNECT_TIMEOUT=5


# ── Sync ──────────────────────────────────────────────────────────────────────
# How often to pull changes from Notion (in minutes)
SYNC_INTERVAL_MINUTES=5


# ── Media proxy ───────────────────────────────────────────────────────────────
# Local HTTP port used to serve downloaded Notion attachments and images.
# Claude references files at http://localhost:PORT/filename
MEDIA_PROXY_PORT=8080


# ── App display ───────────────────────────────────────────────────────────────
# Name shown in the tray tooltip and Settings window title
APP_DISPLAY_NAME=Notion Local Sync
APP_VERSION=3.0

# Name of the MCP server as it appears in Claude Desktop.
# After changing this, click "Auto-configure Claude Desktop" in Settings
# and fully restart Claude Desktop.
CLAUDE_MCP_NAME=Notion Local DB
CLAUDE_MCP_LAST_NAME=


# ── Windows startup ───────────────────────────────────────────────────────────
# Set to 1 to add a Windows registry entry so the app starts on login.
# You can also toggle this in Settings → Sync → "Launch automatically on startup"
WINDOWS_STARTUP_ENABLED=1

# How many minutes before a stale process lock is ignored at startup
INSTANCE_LOCK_STALE_MINUTES=10


# ── Nightly backup ────────────────────────────────────────────────────────────
# Folder where pg_dump backup files are written each night.
# A Google Drive folder works perfectly as the destination.
# Leave blank to disable automatic backups.
# Example: BACKUP_DIR=C:\Users\YourName\Google Drive\Backups\NotionDB
BACKUP_DIR=

# How many days of backup files to keep before the oldest are deleted
BACKUP_RETENTION_DAYS=7

# Hour of the day (0–23, local time) when the nightly backup runs
BACKUP_HOUR=2

# Full path to pg_dump.exe if it is not on your PATH.
# Usually not needed — the app auto-discovers it.
# Example: PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=


# ── AI Self-Healing ───────────────────────────────────────────────────────────
# Optional. When a sync error looks like a code bug, Claude Opus 4.7 diagnoses
# it, patches the source file, and verifies the fix — so the error never recurs.
# Get an API key at: https://console.anthropic.com
# Leave blank to disable. The Settings dialog stores this encrypted.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_ENCRYPTED=

# Set to 0 to disable the self-healing agent without removing the key
ANTHROPIC_HEALER_ENABLED=1
